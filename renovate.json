{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    "helpers:pinGitHubActionDigests"
  ],
  // this will add a label 'renovate' to all PRs created by Renovate
  "labels": ["renovate"],
  // Delay introduction of new versions (give time for security reviews before we introduce the new versions)
  "minimumReleaseAge": "3 days",
  // Create PRs immediately; minimumReleaseAge will still block automerge until stability passes.
  "prCreation": "immediate",
  // Do not filter out pending releases, otherwise PR creation can be delayed.
  "internalChecksFilter": "none",
  // Pin all dependencies to specific digests for security and reproducibility
  "pinDigests": true,
  // PR limit value
  "prConcurrentLimit": 10,
  "packageRules": [
    {
      "matchManagers": ["nuget"],
      "groupName": "nuget dependencies",
      "separateMajorMinor": true
    },
    {
      "matchManagers": ["nuget"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    }
  ]
}
